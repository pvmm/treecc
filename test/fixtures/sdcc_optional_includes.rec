project "Optional includes test"

ruleset {
  "sdcc-bundle-4.2.0": sdcc
}

sdcc::function optional_c {
  attributes [ .OPTIONAL ]
  append-to "out/optional_c.c"
  delimiters [ "---" ]
  contents:
---
void optional_c(void) {
}
---
}

sdcc::function optional_asm {
  attributes [ .OPTIONAL ]
  append-to "out/optional_asm.asm"
  delimiters [ "---" ]
  contents:
---
nop
---
}
