project "Append file test"

ruleset {
  "sdcc-bundle-4.2.0": sdcc
}

sdcc::function example {
  append-to "nested/include/output.asm"
  attributes [ .OPTIONAL ]
  delimiters [ "---------------" ]
  contents-interpolation "false"
  contents:
---------------

PAYLOAD = $sdcc::function / ${sdcc::function}

---------------
}
