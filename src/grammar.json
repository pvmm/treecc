      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\"\"\"[\\s\\S]*?\"\"\""
      }
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\"([^\"\\\\\\n]|\\\\.)*\""
      }
    },
    "variable": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "\\$\\$|\\$[^\\s()\\x5B\\x5D{};,\"]+"
        }
      }
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?"
      }
    },
    "identifier": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\s()\\x5B\\x5D{};,:\"]+(?:::[^\\s()\\x5B\\x5D{};,:\"]+)*"
        }
      }
