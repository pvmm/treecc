project SampleProgram
target "main.rom"

ruleset {
	"shell"
	"sdcc-4.2.0": sdcc
}

sdcc::target z80
sdcc::link_opt [ --no-std-crt0 ]

sdcc::function print_from_asm {
	variable $name "Pedro"
	debug "Hello, $name!"
	//constant BLAH=1                                 // define a constant to be used in assembly
	//sdcc::language assembly                         // optional because file type ends in ".asm")
	attributes [ .OPTIONAL .SIZE ]                  // if ".OPTIONAL" is set, function usage is verified and may not be included in compilation
	delimiters [ "---------------" ]
	signature "void $sdcc::function(char* s);"
	contents:
---------------
CHPUT = #0x00A2

$sdcc::function:
        ld a, (hl)          ; Load the character at address HL into register A
        or a                ; Check if A is 0 (faster than 'cp 0')
        ret z               ; If A == 0 (Zero flag set), end of string reached -> return
        call CHPUT          ; Print the character in A via MSX BIOS
        inc hl              ; Move pointer to the next character
        jr $sdcc::function   ; Repeat the loop
---------------
	append-to "stdio.asm"                 // file to append code to.
}

sdcc::function print_from_c {
	signature "void $sdcc::function(char* s);"
	attributes [ .OPTIONAL ]
	delimiters [ "---------------" ]
	contents: .INCLUDE("print_from_c.c")
	append-to "stdio.c"                   // file to append code to.
}

sdcc::source main {
	filename "main.c"
	include-dirs [ "." "./include" ]
	library-dirs [ "./libs" ]
	variable $romfile "main.rom"

	delimiters [ "{{" "}}" ]
        contents-interpolation true
	trim-contents both
	contents {{
int ${sdcc::source}(void) {
	print_from_asm("Hello, world from ASM!\n");
	print_from_c("Hello, world from C!\n");
loop:
	goto loop;
}
// end of source
	}}

	attributes: shell::stop-on-error                // opposite: shell::ignore-errors
}

actions {
	clean {
		sdcc::clean
	}
	default {
		sdcc::compile main                      // compile .c into .rel
		sdcc::link main                         // link all .rel files into .ihx file
		sdcc::ihx2rom main $main::romfile       // convert .ihx file into .rom file
	}
	run {
		include default
		sdcc::openmsx -carta $file1::romfile
	}
}
